# Copie para .env e preencha.
# provedor: "anthropic" ou "openai" (compativel: DeepSeek, Groq, OpenRouter...)
BT_PROVIDER=anthropic
ANTHROPIC_API_KEY=sua_chave_anthropic
# se usar openai-compativel:
# BT_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sua_chave

BT_SYMBOL=BTC/USDT
BT_TIMEFRAME=1h
BT_CANDLES=500
